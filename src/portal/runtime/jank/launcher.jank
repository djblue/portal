(ns portal.runtime.jank.launcher
  (:include "httplib.h"
            "portal/runtime/jank/server.hpp")
  (:require
   [portal.runtime :as rt]
   [portal.runtime.browser :as browser]
   [portal.runtime.jank.client :as c]
   [portal.runtime.jank.server :as server]))

(defonce ^:private server (atom nil))

(defn- wait-until-ready []
  (when-let [{:keys [http-server]} @server]
    (.wait_until_ready (cpp/unbox (:* httplib.Server) http-server))))

(defn running? []
  (when-let [{:keys [http-server]} @server]
    (.is_running (cpp/unbox (:* httplib.Server) http-server))))

(defn start [options]
  (or @server
      (let [p (promise)
            {:keys [port host]
             :or {port 0 host "127.0.0.1"}} options]
        (future
          (let [http-server (cpp/portal.runtime.jank.server.create_server #'server/handler)
                port (if (zero? port)
                       (.bind_to_any_port http-server host)
                       (do (.bind_to_port http-server host port)
                           port))]
            (deliver p {:http-server (cpp/box http-server)
                        :port port
                        :host host})
            (.listen_after_bind http-server)
            nil))
        (reset! server @p)
        (wait-until-ready)
        @server)))

(defn stop []
  (when-let [{:keys [http-server]} @server]
    (cpp/portal.runtime.jank.server.destroy_server
     (cpp/unbox (:* httplib.Server) http-server)))
  (reset! server nil))

(defn- sessions!
  ([f]
   (sessions! (rt/active-sessions) f))
  ([sessions f]
   (when-let [sessions (seq sessions)]
     (let [response (promise)]
       (doseq [session-id sessions]
         (future
           (try
             (deliver response (f session-id))
             (catch jank.runtime.object_ref ex
               (when (-> ex ex-data ::timeout)
                 (swap! rt/connections dissoc session-id))
               (deliver response ex)))))
       (let [response (deref response c/timeout ::timeout)]
         (cond
           (not= response ::timeout)
           response
           :else
           (throw (ex-info
                   "Portal request timeout"
                   {::timeout true
                    :session-id :all}))))))))

(defn open
  ([options]
   (open nil options))
  ([portal options]
   (let [server (start options)]
     (browser/open {:portal portal :options options :server server}))))

(defn- clear-1 [session-id]
  (c/request session-id {:op :portal.rpc/clear}))

(defn clear [portal]
  (if (= portal :all)
    (sessions! clear-1)
    (clear-1 (:session-id portal)))
  (rt/cleanup-sessions))

(defn- close-1 [session-id]
  (c/request session-id {:op :portal.rpc/close})
  (rt/close-session session-id))

(defn close [portal]
  (if (= portal :all)
    (sessions! close-1)
    (close-1 (:session-id portal)))
  (rt/cleanup-sessions))

(defn eval-str [portal msg]
  (let [response
        (if (= portal :all)
          (sessions!
           #(c/request % (assoc msg :op :portal.rpc/eval-str)))
          (c/request (:session-id portal) (assoc msg :op :portal.rpc/eval-str)))]
    (if-not (:error response)
      response
      (throw (ex-info (:message response) response)))))

(defn sessions []
  (for [session-id (rt/active-sessions)] (c/make-atom session-id)))

(defn url [portal]
  (browser/url {:portal portal :server @server}))

(comment
  (-> @server)
  (start {:host "localhost" :port 8000})
  (stop)
  ;; (get-port)
  ;; (stop)
  comment)

(reset! rt/request c/request)