<idea-plugin>
    <id>djblue.portal</id>
    <name>Portal Inspector</name>
    <vendor url="https://github.com/djblue/portal">djblue</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- JCEF became a separate bundled plugin in IDEA 2026.2.
     Optional keeps compatibility with older IDEA versions,
     where JCEF is part of the platform itself. -->
    <depends optional="true" config-file="withJcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Portal"
                    anchor="right"
                    icon="PortalIcons.ToolWindow"
                    factoryClass="portal.extensions.intellij.Factory" />
    </extensions>

    <projectListeners>
        <listener
            class="portal.extensions.intellij.Factory"
            topic="com.intellij.ide.ui.UISettingsListener"/>
        <listener
            class="portal.extensions.intellij.Factory"
            topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
    </projectListeners>
</idea-plugin>
