<idea-plugin>
    <id>djblue.portal</id>
    <name>Portal Inspector</name>
    <vendor url="https://github.com/djblue/portal">djblue</vendor>

    <depends>com.intellij.modules.platform</depends>

    <!-- JCEF (JBCefBrowser) moved out of the platform core into its own
         bundled plugin/module starting with IDE build 262 (2026.2). The
         module id doesn't exist on older builds, so this must stay
         optional to keep working on IDEs down to pluginSinceBuild. -->
    <depends optional="true" config-file="withJcef.xml">com.intellij.modules.jcef</depends>
</idea-plugin>
